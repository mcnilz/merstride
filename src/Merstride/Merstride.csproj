<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>merstride</AssemblyName>
    <RootNamespace>Merstride</RootNamespace>
    <Version>0.1.0</Version>
    <PublishAot>true</PublishAot>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' == 'linux-x64'">packages.linux-x64.lock.json</NuGetLockFilePath>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <WarningsAsErrors>$(WarningsAsErrors);NSDEPCOP01;NSDEPCOP07</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Cli/CreationGuide.txt" LogicalName="Merstride.CreationGuide.txt" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="NsDepCop" Version="3.3.0" PrivateAssets="all" ExcludeAssets="compile;runtime" />
  </ItemGroup>
</Project>
